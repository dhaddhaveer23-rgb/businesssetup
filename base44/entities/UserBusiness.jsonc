{
  "name": "UserBusiness",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "business_type": {
      "type": "string"
    },
    "business_type_id": {
      "type": "string"
    },
    "country_code": {
      "type": "string"
    },
    "answers": {
      "type": "object"
    },
    "checklist_progress": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed"
      ],
      "default": "in_progress"
    }
  },
  "required": [
    "name",
    "business_type",
    "country_code"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}